{
  "sourceLanguage": "en",
  "strings": {
    "127.0.0.1:2019 already accepts connections. Caddyman will not take over a process whose ownership is unknown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:2019 已有进程接受连接。Caddyman 不会接管所有权不明的进程。"
          }
        }
      }
    },
    "A Caddyfile block is incomplete or has unbalanced braces.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyfile 配置块不完整或大括号不匹配。"
          }
        }
      }
    },
    "A Caddyman managed-region marker is malformed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 托管区域的标记格式有误。"
          }
        }
      }
    },
    "A Caddyman site marker is incomplete or malformed. No site changes were saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 站点标记不完整或格式错误，未保存任何更改。"
          }
        }
      }
    },
    "A Caddyman-managed site block cannot be safely interpreted. No site changes were saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全解析 Caddyman 托管的站点配置块，未保存任何更改。"
          }
        }
      }
    },
    "A different LaunchAgent already uses Caddyman's service label or plist path. Caddyman will not change it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 LaunchAgent 已占用 Caddyman 的服务标识或 plist 路径，Caddyman 不会修改它。"
          }
        }
      }
    },
    "A local process accepts connections on the default Caddy Admin API port. Process ownership is not confirmed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机进程正在接受默认 Caddy 管理 API 端口的连接，但尚未确认该进程的归属。"
          }
        }
      }
    },
    "A local, menu bar manager for one Caddy instance.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单实例 Caddy 的本机菜单栏管理器。"
          }
        }
      }
    },
    "A site for %@ already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点 %@ 已存在。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About detection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于检测"
          }
        }
      }
    },
    "ACME environment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ACME 环境"
          }
        }
      }
    },
    "Add a site to preview and validate a Caddyfile change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加站点后，可预览并校验 Caddyfile 更改。"
          }
        }
      }
    },
    "Add Site…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加站点…"
          }
        }
      }
    },
    "Admin port occupied; ownership unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理端口已被占用，进程归属未知"
          }
        }
      }
    },
    "An older Caddy login service is installed. It can keep running after Caddyman quits.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装旧版 Caddy 登录服务。它可能在 Caddyman 退出后继续运行。"
          }
        }
      }
    },
    "App session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会话"
          }
        }
      }
    },
    "Application details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用信息"
          }
        }
      }
    },
    "Apply site changes?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要应用站点更改吗？"
          }
        }
      }
    },
    "Apply this migration?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要应用此迁移吗？"
          }
        }
      }
    },
    "Approve Caddyman in System Settings > Login Items to finish setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 > 登录项”中允许 Caddyman 以完成设置。"
          }
        }
      }
    },
    "Automatic Homebrew discovery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动查找 Homebrew 安装"
          }
        }
      }
    },
    "Automatic HTTPS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动 HTTPS"
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Back Up and Apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份并应用"
          }
        }
      }
    },
    "Back Up and Apply…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份并应用…"
          }
        }
      }
    },
    "Binary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二进制文件"
          }
        }
      }
    },
    "Blocked by previous service": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被旧版服务阻止"
          }
        }
      }
    },
    "Bundle ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件包标识符"
          }
        }
      }
    },
    "Caddy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy"
          }
        }
      }
    },
    "Caddy binary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 二进制文件"
          }
        }
      }
    },
    "Caddy binary not found": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Caddy 二进制文件"
          }
        }
      }
    },
    "Caddy certificate activity: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 证书活动：%@"
          }
        }
      }
    },
    "Caddy configuration validation failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 配置校验失败：%@"
          }
        }
      }
    },
    "Caddy could not be stopped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法停止 Caddy"
          }
        }
      }
    },
    "Caddy could not inspect the adapted configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 Caddy 转换后的配置。"
          }
        }
      }
    },
    "Caddy detection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 检测"
          }
        }
      }
    },
    "Caddy follows Caddyman": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 跟随 Caddyman"
          }
        }
      }
    },
    "Caddy inspection failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 检测失败"
          }
        }
      }
    },
    "Caddy login service enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 Caddy 登录服务。"
          }
        }
      }
    },
    "Caddy login service removed. The Caddyfile and certificates were kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 Caddy 登录服务；Caddyfile 和证书已保留。"
          }
        }
      }
    },
    "Caddy Manager": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 管理器"
          }
        }
      }
    },
    "Caddy may request certificates and DNSPod sites may create temporary DNS records. Caddyman validates the selected Caddyfile before starting it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 可能申请证书，DNSPod 站点可能创建临时 DNS 记录。启动前 Caddyman 会校验所选 Caddyfile。"
          }
        }
      }
    },
    "Caddy may request certificates and DNSPod sites may create temporary DNS records. The selected Caddyfile will be validated before the service is installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 可能申请证书，DNSPod 站点可能创建临时 DNS 记录。安装服务前会校验所选 Caddyfile。"
          }
        }
      }
    },
    "Caddy may request or renew certificates and DNSPod sites may create temporary DNS challenge records.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 可能申请或续期证书，DNSPod 站点可能创建临时 DNS 验证记录。"
          }
        }
      }
    },
    "Caddy may request or renew certificates from the configured ACME CA. DNSPod sites may create temporary DNS challenge records using the saved credential.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 可能会向配置的 ACME 证书机构申请或续期证书。DNSPod 站点可能会使用已保存的凭据创建临时 DNS 验证记录。"
          }
        }
      }
    },
    "Caddy now starts with Caddyman and stops when Caddyman quits.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 现在随 Caddyman 启动，并在正常退出 Caddyman 时停止。"
          }
        }
      }
    },
    "Caddy rejected the reload: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 拒绝了重载：%@"
          }
        }
      }
    },
    "Caddy reported a certificate error: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 报告证书错误：%@"
          }
        }
      }
    },
    "Caddy reports that it obtained a certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 报告已获取证书。"
          }
        }
      }
    },
    "Caddy returned a valid but empty module list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 返回了有效但为空的模块列表。"
          }
        }
      }
    },
    "Caddy returned an empty module list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 返回的模块列表为空。"
          }
        }
      }
    },
    "Caddy returned an empty version string.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 返回的版本信息为空。"
          }
        }
      }
    },
    "Caddy returned an unreadable adapted configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 返回的转换后配置无法读取。"
          }
        }
      }
    },
    "Caddy returned data that is not valid JSON.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 返回的数据不是有效的 JSON。"
          }
        }
      }
    },
    "Caddy runtime": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 运行状态"
          }
        }
      }
    },
    "Caddy service": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 服务"
          }
        }
      }
    },
    "Caddy service and site status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 服务与站点状态"
          }
        }
      }
    },
    "Caddy Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 设置"
          }
        }
      }
    },
    "Caddy started but did not open its loopback Admin API. Caddyman stopped its process.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 已启动但未开放本机回环管理 API。Caddyman 已停止自己启动的进程。"
          }
        }
      }
    },
    "Caddy validated the candidate configuration successfully.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 已成功校验候选配置。"
          }
        }
      }
    },
    "Caddy validation failed with exit status %d.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 校验失败，退出状态码：%d。"
          }
        }
      }
    },
    "Caddy version command exited with status %d. Check the selected binary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 版本命令退出，状态码为 %d。请检查所选二进制文件。"
          }
        }
      }
    },
    "Caddy version was detected, but list-modules exited with status %d.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 Caddy 版本，但 list-modules 命令退出，状态码为 %d。"
          }
        }
      }
    },
    "Caddy version was detected, but the module query failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 Caddy 版本，但无法查询模块：%@"
          }
        }
      }
    },
    "Caddy was not found in the standard Homebrew locations. Choose an existing Caddy executable in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在常见的 Homebrew 路径中找到 Caddy。请在设置中选择已有的 Caddy 可执行文件。"
          }
        }
      }
    },
    "Caddy will no longer start automatically with Caddyman.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 将不再随 Caddyman 自动启动。"
          }
        }
      }
    },
    "Caddyfile": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyfile"
          }
        }
      }
    },
    "Caddyfile (read only)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyfile（只读）"
          }
        }
      }
    },
    "Caddyfile migration preview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyfile 迁移预览"
          }
        }
      }
    },
    "Caddyman": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman"
          }
        }
      }
    },
    "Caddyman already has a Caddy process running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 已有一个 Caddy 进程在运行。"
          }
        }
      }
    },
    "Caddyman app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 应用"
          }
        }
      }
    },
    "Caddyman checks the selected executable with `caddy version` and `caddy list-modules --json`. The DNSPod option is available only when the binary reports `dns.providers.dnspod`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 会检查所选二进制文件的版本和模块列表。只有报告包含 `dns.providers.dnspod` 模块时，才支持 DNSPod。"
          }
        }
      }
    },
    "Caddyman could not access the DNSPod item in Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 无法访问钥匙串中的 DNSPod 项目。"
          }
        }
      }
    },
    "Caddyman could not atomically replace the target Caddyfile. The original file was kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 无法原子替换目标 Caddyfile，原文件已保留。"
          }
        }
      }
    },
    "Caddyman could not create a protected backup of the target Caddyfile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 无法创建受保护的目标 Caddyfile 备份。"
          }
        }
      }
    },
    "Caddyman could not start its Caddy process. Check the Caddyfile and binary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 无法启动自己的 Caddy 进程。请检查 Caddyfile 和二进制文件。"
          }
        }
      }
    },
    "Caddyman could not stop the Caddy process it started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 无法停止自己启动的 Caddy 进程。"
          }
        }
      }
    },
    "Caddyman did not find a listener on the default local Admin API port. Caddy may use a custom port or have its Admin API disabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 未在默认本机管理 API 端口上发现监听程序。Caddy 可能使用了自定义端口，或已禁用管理 API。"
          }
        }
      }
    },
    "Caddyman does not own a running Caddy process to reload.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 没有可重载的自有 Caddy 进程。"
          }
        }
      }
    },
    "Caddyman does not start, stop, reload, or take over a Caddy process in this version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Caddyman 不会启动、停止、重载或接管 Caddy 进程。"
          }
        }
      }
    },
    "Caddyman is quitting and cannot start Caddy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 正在退出，无法启动 Caddy。"
          }
        }
      }
    },
    "Caddyman login setting updated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 登录启动设置已更新。"
          }
        }
      }
    },
    "Caddyman never downloads or replaces Caddy. Select an existing executable you trust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddyman 不会下载或替换 Caddy。请选择你信任的现有可执行文件。"
          }
        }
      }
    },
    "Caddyman Overview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
