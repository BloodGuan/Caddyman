    "Site configuration saved and reloaded. Backup created at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点配置已保存并重载。备份位于：%@。"
          }
        }
      }
    },
    "Site configuration saved. Caddyman is not running this Caddyfile, so no service was reloaded. Backup created at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点配置已保存。Caddyman 未运行此 Caddyfile 对应的服务，因此未重载服务。备份位于：%@。"
          }
        }
      }
    },
    "Site configuration was restored because readback failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于配置回读失败，已恢复旧站点配置：%@"
          }
        }
      }
    },
    "Site readback failed and Caddyman could not safely restore the previous file: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点配置回读失败，且 Caddyman 无法安全恢复旧文件：%@"
          }
