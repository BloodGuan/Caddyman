        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待导入站点：%d"
          }
        }
      }
    },
    "Some interface patterns were adapted from Caddock with permission. Caddyman is an independent project.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分界面模式经许可参考并改编自 Caddock。Caddyman 是独立项目。"
          }
        }
      }
    },
    "Source Caddyfile": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源 Caddyfile"
          }
        }
      }
    },
    "Staging certificates are intentionally not trusted by browsers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试环境证书不会被浏览器信任。"
          }
        }
      }
    },
    "Start Caddy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 Caddy"
          }
        }
      }
    },
    "Start Caddy with Caddyman": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caddy 随 Caddyman 启动"
          }
        }
      }
    },
    "Start Caddy with Caddyman?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Caddy 随 Caddyman 启动？"
          }
        }
      }
    },
    "Start opens only a process launched by Caddyman and requires an available loopback Admin API. An existing listener will never be taken over.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动操作只会创建由 Caddyman 启动的进程，并要求本机回环管理 API 可用。Caddyman 不会接管已有监听进程。"
          }
        }
      }
    },
    "Start the selected Caddy configuration?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要启动所选 Caddy 配置吗？"
          }
        }
      }
    },
    "Start together, stop together": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起启动，一起停止"
          }
        }
