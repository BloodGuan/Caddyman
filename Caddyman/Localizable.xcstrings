    },
    "Use an HTTP or HTTPS upstream, such as `http://127.0.0.1:3000`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游地址需使用 HTTP 或 HTTPS，例如 `http://127.0.0.1:3000`。"
