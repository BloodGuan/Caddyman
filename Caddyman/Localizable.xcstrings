            "state": "translated",
            "value": "LaunchAgent 配置不完整或不安全。"
          }
        }
      }
    },
    "The local Admin API is responding for Caddyman's managed process.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机管理 API 正在响应 Caddyman 托管的进程。"
          }
        }
      }
    },
    "The login service is running. Certificate activity continues in the background.": {
      "localizations": {
        "zh-Hans": {
