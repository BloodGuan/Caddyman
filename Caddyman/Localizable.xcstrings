    "Update with selected configuration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用所选配置更新"
          }
        }
      }
    },
    "Upstream URL or host:port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游 URL 或主机:端口"
          }
