      }
    },
    "The selected target Caddyfile changed. Reopen the site editor before applying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选目标 Caddyfile 已更改。请重新打开站点编辑器后再应用。"
          }
        }
      }
    },
    "The site port must be a number from 1 to 65535.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点端口必须是 1 到 65535 之间的数字。"
          }
        }
      }
    },
    "The site will be removed from the Caddyman managed region after you review, validate, and confirm the complete diff.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查并校验完整差异后，确认即可从 Caddyman 托管区域移除此站点。"
          }
        }
      }
    },
    "The source contains top-level content other than site blocks. Caddyman cannot safely place it in the managed region.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件包含站点块以外的顶层内容，Caddyman 无法安全地将其放入托管区域。"
          }
        }
      }
    },
    "The source file does not contain any importable site blocks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件中没有可导入的站点块。"
          }
        }
      }
    },
    "The source managed-region markers are invalid: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件的托管区域标记无效：%@"
          }
        }
      }
    },
    "The target Caddyfile changed after the preview. Reload it and review a new diff before applying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览后目标 Caddyfile 已更改。请重新读取文件并检查新的差异后再应用。"
          }
        }
      }
    },
    "The target managed-region markers are invalid: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标文件的托管区域标记无效：%@"
          }
        }
      }
    },
    "The token will be written in plain text to the Caddyfile. Anyone who can read that file can use it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 将以明文写入 Caddyfile。任何能读取该文件的人都可以使用它。"
          }
        }
      }
    },
    "The update failed and the previous service could not be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新失败，且无法恢复原有服务。"
          }
        }
      }
    },
    "These Caddyfile blocks are shown for reference and preserved verbatim. Caddyman can edit sites that it created with a per-site marker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Caddyfile 配置块仅供查看并会逐字保留。Caddyman 可以编辑带有单站点标记的配置。"
          }
        }
      }
    },
    "This binary reports dns.providers.dnspod.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二进制文件报告包含 dns.providers.dnspod 模块。"
          }
        }
      }
    },
    "This Caddy binary does not report dns.providers.dnspod. DNSPod DNS-01 will be unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Caddy 二进制文件未报告 dns.providers.dnspod 模块，因此无法使用 DNSPod DNS-01。"
          }
        }
      }
    },
    "This Caddy version returned an unsupported module-list format.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Caddy 返回了不受支持的模块列表格式。"
          }
        }
      }
    },
    "This marked site contains manual changes. Caddyman will not overwrite them; edit the Caddyfile directly or restore the original generated block.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标记站点包含手工修改。Caddyman 不会覆盖这些内容；请直接编辑 Caddyfile 或恢复最初生成的站点块。"
          }
        }
      }
    },
    "This view is read-only. Caddyman has not changed the selected file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视图为只读。Caddyman 未更改所选文件。"
          }
        }
      }
    },
