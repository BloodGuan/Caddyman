          "stringUnit": {
            "state": "translated",
            "value": "所选 Caddy 路径不存在或不可执行"
          }
        }
      }
    },
    "The selected Caddy path is missing or is not executable: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 Caddy 路径不存在或不可执行：%@"
          }
        }
      }
    },
    "The selected Caddyfile is not a regular file, so Caddyman cannot replace it safely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 Caddyfile 不是普通文件，Caddyman 无法安全替换。"
          }
