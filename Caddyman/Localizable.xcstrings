    "The previous Caddyfile was restored, but its reload also failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧 Caddyfile 已恢复，但重新加载也失败：%@"
          }
        }
      }
    },
    "The saved Caddyfile did not read back as the proposed site configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后的 Caddyfile 与预期站点配置不一致。"
          }
        }
      }
    },
    "The selected Caddy binary must contain dns.providers.dnspod before DNSPod can be used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 Caddy 二进制文件必须包含 dns.providers.dnspod 模块才能使用 DNSPod。"
          }
        }
      }
    },
    "The selected Caddy path is missing or is not executable": {
      "localizations": {
