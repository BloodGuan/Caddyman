      }
    },
    "The selected target Caddyfile changed. Reopen the migration preview before applying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选目标 Caddyfile 已更改。请重新打开迁移预览后再应用。"
          }
