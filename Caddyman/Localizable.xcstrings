        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管区域的起始标记重复出现。"
          }
        }
      }
    },
    "The managed-region start marker is missing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少托管区域的起始标记。"
          }
        }
      }
